{
  "expo": {
    "name": "Table Games",
    "slug": "table-games",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-new.png",
    "userInterfaceStyle": "light",
    "scheme": "table-games",
    "splash": {
      "image": "./assets/splash-icon-new.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAFAFA"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tablegames.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.tablegames.app"
    },
    "web": {
      "name": "Table Games",
      "shortName": "Table Games",
      "description": "Classic table games you can play solo or pass-and-play, fully offline.",
      "themeColor": "#243A49",
      "backgroundColor": "#243A49",
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ]
  }
}
