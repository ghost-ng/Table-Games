{
  "name": "table-games",
  "version": "1.0.0",
  "description": "A collection of local multiplayer table games and game-night tools built with Expo.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ghost-ng/Table-Games.git"
  },
  "bugs": {
    "url": "https://github.com/ghost-ng/Table-Games/issues"
  },
  "homepage": "https://ghost-ng.github.io/Table-Games/",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  },
  "packageManager": "npm@11.4.2",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --web",
    "dev": "npm run start",
    "start:native": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build": "expo export -p web --clear && node scripts/build-pwa.mjs",
    "build:pages": "EXPO_BASE_URL=/Table-Games npm run build",
    "preview": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx --test src/utils/responsive.test.ts src/engines/hangman.test.ts src/utils/hangmanStages.test.ts",
    "test:wsl": "node --test scripts/wsl/wsl-scripts.test.mjs",
    "test:public": "node --test scripts/public-readiness.test.mjs",
    "check:public": "node scripts/public-readiness.mjs",
    "verify": "npm run test:unit && npm run typecheck && npm run build",
    "verify:all": "npm run test:wsl && npm run verify",
    "clean": "node scripts/clean.mjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.0.1",
    "babel-preset-expo": "~55.0.8",
    "expo": "~55.0.6",
    "expo-constants": "^55.0.7",
    "expo-font": "^55.0.4",
    "expo-haptics": "^55.0.8",
    "expo-linking": "^55.0.7",
    "expo-router": "^55.0.5",
    "expo-splash-screen": "^55.0.10",
    "expo-status-bar": "~55.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.2",
    "react-native-gesture-handler": "^2.30.0",
    "react-native-reanimated": "^4.2.2",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-screens": "^4.24.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2"
  },
  "private": true
}
